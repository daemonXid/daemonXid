---
import Base from "../../layouts/Base.astro";
import ProjectCard from "../../components/ProjectCard.astro";

const operationalSystems = [
    {
        name: "ClubKebi",
        desc: "A live operations Web SaaS that turns a sports academy's paper-and-spreadsheet workflows into student, attendance, makeup-class, and revenue management.",
        stack: ["Django", "Multi-tenant", "PostgreSQL", "Web SaaS"],
        url: "https://clubkebi.com",
        github: null,
        href: "/portfolio/clubkebi",
        status: "live" as const,
    },
    {
        name: "LawNGood POC",
        desc: "A client POC that automated a legal-news workflow where one employee monitored and classified up to 60 articles per day.",
        stack: [
            "Django",
            "Naver News API",
            "BeautifulSoup4",
            "Gemini API",
            "PostgreSQL",
        ],
        url: null,
        github: "https://github.com/ken-do-it/law_news_c_v2",
        href: "/portfolio/lawngood",
        status: "live" as const,
    },
];

const architecture = [
    {
        name: "DAEMON-ONE",
        desc: "Django architecture principles for turning complex field operations into maintainable systems.",
        stack: ["Django", "HTMX", "pgvector", "Pydantic"],
        url: null,
        github: null,
        href: "/portfolio/daemon-one",
        status: "arch" as const,
    },
];

const aiProducts = [
    {
        name: "Almaeng",
        desc: "AI supplement analysis and price intelligence project focused on ingredient transparency and practical value comparison.",
        stack: ["DAEMON-ONE", "Django Ninja", "HTMX", "pgvector", "Coolify"],
        url: null,
        github: null,
        href: "/portfolio/almaeng",
        status: "offline" as const,
    },
    {
        name: "BriefKR",
        desc: "A live news and policy briefing service.",
        stack: ["Web Service"],
        url: "https://briefkr.com",
        github: null,
        status: "live" as const,
    },
];

const products = [
    {
        name: "Salmal",
        desc: "A live public service. Visit the website for details.",
        stack: ["Web Service"],
        url: "https://salmal.app",
        github: null,
        status: "live" as const,
    },
    {
        name: "PivotKebi",
        desc: "A live public service. Visit the website for details.",
        stack: ["Web Service"],
        url: "https://pivotkebi.com",
        github: null,
        status: "live" as const,
    },
];
---

<Base
    title="Wonsub Song (Tony) | Portfolio"
    lang="en"
    description="Projects and architecture for turning repeated field work into operational systems teams can rely on."
>
    <header class="mb-12">
        <h1 class="text-3xl font-bold mb-3">Portfolio</h1>
        <p style="color:#8b949e;" class="text-sm">
            I turn repeated field work into operational systems teams can rely on every day.
        </p>
    </header>

    <div class="portfolio-sections">
        <section class="portfolio-section">
            <h2 class="section-label">Operational Systems</h2>
            <div class="cards-grid">
                {operationalSystems.map((p) => <ProjectCard {...p} />)}
            </div>
        </section>

        <section class="portfolio-section">
            <h2 class="section-label">Architecture</h2>
            <div class="cards-grid">
                {architecture.map((p) => <ProjectCard {...p} />)}
            </div>
        </section>

        <section class="portfolio-section">
            <h2 class="section-label">Personal AI Projects</h2>
            <div class="cards-grid">
                {aiProducts.map((p) => <ProjectCard {...p} />)}
            </div>
        </section>

        <section class="portfolio-section">
            <h2 class="section-label">Products</h2>
            <div class="cards-grid">
                {products.map((p) => <ProjectCard {...p} />)}
            </div>
        </section>
    </div>
</Base>

<style>
    .portfolio-sections {
        display: flex;
        flex-direction: column;
        gap: 3rem;
    }
    .section-label {
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: rgba(250, 204, 21, 0.6);
        margin-bottom: 1rem;
    }
    .cards-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.85rem;
    }
    @media (min-width: 640px) {
        .cards-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>
