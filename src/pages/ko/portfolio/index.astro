---
import Base from '../../../layouts/Base.astro'
import ProjectCard from '../../../components/ProjectCard.astro'

const operationalSystems = [
  {
    name: 'ClubKebi',
    desc: '스포츠 학원의 수기·엑셀 운영 부담을 학생·출석·보강·매출 관리 흐름으로 전환한 운영 Web SaaS입니다.',
    stack: ['Django', 'Multi-tenant', 'PostgreSQL', 'Web SaaS'],
    url: 'https://clubkebi.com',
    github: null,
    href: '/ko/portfolio/clubkebi',
    status: 'live' as const,
  },
  {
    name: 'LawNGood POC',
    desc: '담당자 1명이 매일 최대 60개 기사를 직접 모니터링·분류하던 업무를 수집·파싱·AI 분류·리뷰 흐름으로 자동화한 고객 POC입니다.',
    stack: ['Django', 'Naver News API', 'BeautifulSoup4', 'Gemini API', 'PostgreSQL'],
    url: null,
    github: 'https://github.com/ken-do-it/law_news_c_v2',
    href: '/ko/portfolio/lawngood',
    status: 'live' as const,
  },
]

const architecture = [
  {
    name: 'DAEMON-ONE',
    desc: '복잡한 현장 업무를 유지 가능한 운영 시스템으로 만들기 위한 Django 아키텍처 원칙입니다.',
    stack: ['Django', 'HTMX', 'pgvector', 'Pydantic'],
    url: null,
    github: null,
    href: '/ko/portfolio/daemon-one',
    status: 'arch' as const,
  },
]

const aiProducts = [
  {
    name: 'Almaeng',
    desc: '성분 투명성과 가격 효율 비교를 다뤘던 AI 영양제 분석 및 가격 인텔리전스 프로젝트입니다.',
    stack: ['DAEMON-ONE', 'Django Ninja', 'HTMX', 'pgvector', 'Coolify'],
    url: null,
    github: null,
    href: '/ko/portfolio/almaeng',
    status: 'offline' as const,
  },
  {
    name: 'BriefKR',
    desc: '뉴스와 정책 브리핑을 제공하는 공개 서비스입니다.',
    stack: ['Web Service'],
    url: 'https://briefkr.com',
    github: null,
    status: 'live' as const,
  },
]

const products = [
  {
    name: 'Salmal',
    desc: '공개 운영 중인 서비스입니다. 자세한 내용은 웹사이트에서 확인할 수 있습니다.',
    stack: ['Web Service'],
    url: 'https://salmal.app',
    github: null,
    status: 'live' as const,
  },
  {
    name: 'PivotKebi',
    desc: '공개 운영 중인 서비스입니다. 자세한 내용은 웹사이트에서 확인할 수 있습니다.',
    stack: ['Web Service'],
    url: 'https://pivotkebi.com',
    github: null,
    status: 'live' as const,
  },
]
---

<Base title="Wonsub Song (Tony) | 포트폴리오" lang="ko" description="현장의 반복 업무를 운영 가능한 시스템으로 전환한 프로젝트와 아키텍처 기록입니다.">
  <header class="mb-12">
    <h1 class="text-3xl font-bold mb-3">포트폴리오</h1>
    <p style="color:#8b949e;" class="text-sm">
      현장의 반복 업무를 팀이 매일 사용할 수 있는 운영 시스템으로 전환합니다.
    </p>
  </header>

  <div class="portfolio-sections">
    <section class="portfolio-section">
      <h2 class="section-label">운영 시스템</h2>
      <div class="cards-grid">
        {operationalSystems.map(p => <ProjectCard {...p} />)}
      </div>
    </section>

    <section class="portfolio-section">
      <h2 class="section-label">아키텍처</h2>
      <div class="cards-grid">
        {architecture.map(p => <ProjectCard {...p} />)}
      </div>
    </section>

    <section class="portfolio-section">
      <h2 class="section-label">개인 AI 프로젝트</h2>
      <div class="cards-grid">
        {aiProducts.map(p => <ProjectCard {...p} />)}
      </div>
    </section>

    <section class="portfolio-section">
      <h2 class="section-label">제품</h2>
      <div class="cards-grid">
        {products.map(p => <ProjectCard {...p} />)}
      </div>
    </section>
  </div>
</Base>

<style>
  .portfolio-sections { display: flex; flex-direction: column; gap: 3rem; }
  .section-label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(250, 204, 21, 0.6);
    margin-bottom: 1rem;
  }
  .cards-grid { display: grid; grid-template-columns: 1fr; gap: 0.85rem; }
  @media (min-width: 640px) { .cards-grid { grid-template-columns: repeat(2, 1fr); } }
</style>
